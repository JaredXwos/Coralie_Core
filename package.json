{
  "name": "nostr-webrtc-mesh",
  "version": "0.0.0",
  "description": "Portable Coralie HTML runtime and lightweight WebRTC-over-Nostr peer mesh for browser and Android interoperability.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:library && npm run build:host && npm run build:test-harness",
    "build:library": "tsup --config tsup.config.ts",
    "build:host": "tsup --config tsup.host.config.ts",
    "build:test-harness": "tsup --config tsup.internal.config.ts",
    "pretest": "npm run build:library",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "pretest:integration": "npm run build",
    "test:integration": "playwright test src/integration.spec.ts --headed",
    "pretest:integration:headless": "npm run build",
    "test:integration:headless": "playwright test src/integration.spec.ts"
  },
  "keywords": [
    "coralie",
    "html-runtime",
    "nostr",
    "webrtc",
    "mesh",
    "p2p",
    "party-game",
    "static-site"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "nostr-tools": "^2.23.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "module": "./dist/index.js",
  "sideEffects": true
}
