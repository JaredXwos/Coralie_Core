{
  "name": "nostr-webrtc-mesh",
  "version": "0.0.0",
  "description": "Fast, gossip-style WebRTC mesh networking over Nostr signalling",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:integration": "vitest run --reporter=verbose --grep @integration",
    "build": "tsup src/index.ts --format esm,cjs,umd --dts --sourcemap --global-name NostrWebRTCMesh"
  },
  "keywords": [
    "nostr",
    "webrtc",
    "mesh",
    "p2p",
    "networking"
  ],
  "license": "MIT",
  "dependencies": {
    "nostr-tools": "^2.23.12"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/browser": "^4.1.10",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
